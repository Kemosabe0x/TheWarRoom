{
  "tools": [
    {
      "name": "query_nfl_snapshot",
      "description": "Read a bounded legacy NFL page; pin snapshot_id when paginating.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "enum": [
                  "analytics",
                  "fantasy",
                  "gm",
                  "gruden",
                  "scout"
                ],
                "type": "string"
              },
              "offset": {
                "default": 0,
                "maximum": 1000000,
                "minimum": 0,
                "type": "integer"
              },
              "limit": {
                "default": 25,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "week": {
                "anyOf": [
                  {
                    "maximum": 30,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "player_name": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "expected_snapshot_id": {
                "anyOf": [
                  {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "dataset"
            ],
            "type": "object"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "type": "string"
          },
          "status": {
            "enum": [
              "legacy_unverified",
              "unavailable",
              "observed"
            ],
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "type": "string"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "dataset": {
                    "enum": [
                      "analytics",
                      "fantasy",
                      "gm",
                      "gruden",
                      "scout"
                    ],
                    "type": "string"
                  },
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "rows": {
                    "items": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "matching_rows": {
                    "type": "integer"
                  },
                  "next_offset": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "dataset",
                  "columns",
                  "rows",
                  "matching_rows",
                  "next_offset"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "status",
          "source"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "meta": {
        "fastmcp": {
          "tags": [
            "fantasy"
          ]
        }
      }
    },
