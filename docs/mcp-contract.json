    {
      "name": "evaluate_combo_bet",
      "description": "Calculate hypothetical all-legs-win EV using an explicit joint probability.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "scenario": {
            "additionalProperties": false,
            "description": "Caller assumptions for ONE all-legs-win contract, never a basket of singles.",
            "properties": {
              "legs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "venue": {
                      "enum": [
                        "kalshi",
                        "polymarket"
                      ],
                      "type": "string"
                    },
                    "market_id": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_.:-]+$",
                      "type": "string"
                    },
                    "outcome_id": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_.:-]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "venue",
                    "market_id",
                    "outcome_id"
                  ],
                  "type": "object"
                },
                "maxItems": 10,
                "minItems": 2,
                "type": "array"
              },
              "joint_probability": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "probability_basis": {
                "maxLength": 1000,
                "minLength": 10,
                "type": "string"
              },
              "total_cost": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "total_payout_if_all_win": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "total_fees": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "default": "0"
              },
              "currency": {
                "default": "USD",
                "enum": [
                  "USD",
                  "USDC",
                  "pUSD"
                ],
                "type": "string"
              }
            },
            "required": [
              "legs",
              "joint_probability",
              "probability_basis",
              "total_cost",
              "total_payout_if_all_win"
            ],
            "type": "object"
          }
        },
        "required": [
          "scenario"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "hypothetical",
            "default": "hypothetical",
            "type": "string"
          },
          "expected_profit": {
            "type": "string"
          },
          "maximum_loss": {
            "type": "string"
          },
          "return_on_cost": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "probability_basis": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "expected_profit",
          "maximum_loss",
          "return_on_cost",
          "currency",
          "probability_basis",
          "warnings"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "meta": {
        "fastmcp": {
          "tags": [
            "analysis",
            "betting"
          ]
        }
      }
    },
    {
      "name": "execute_combo_bet",
      "description": "Reserved action schema. Always fails closed; no venue orders are submitted.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "request": {
            "additionalProperties": false,
            "description": "Reserved action contract: identifiers must resolve to server-owned records.",
            "properties": {
              "plan_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "max_total_cost": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "expires_at": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "plan_id",
              "idempotency_key",
              "max_total_cost",
              "expires_at"
            ],
            "type": "object"
          }
        },
        "required": [
          "request"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "submitted",
              "partially_filled",
              "filled",
              "cancelled",
              "unknown"
            ],
            "type": "string"
          },
          "order_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "plan_id",
          "state",
          "order_ids"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "meta": {
        "fastmcp": {
          "tags": [
            "betting",
            "execution"
          ]
        }
      }
    },
