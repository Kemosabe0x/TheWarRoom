    {
      "name": "get_live_markets",
      "description": "Live market contract; reports unavailable until venue collectors exist.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "additionalProperties": false,
            "properties": {
              "venue": {
                "enum": [
                  "kalshi",
                  "polymarket"
                ],
                "type": "string"
              },
              "asset": {
                "default": "BTC",
                "pattern": "^[A-Z0-9]{2,12}$",
                "type": "string"
              },
              "interval_minutes": {
                "const": 15,
                "default": 15,
                "type": "integer"
              },
              "limit": {
                "default": 25,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "venue"
            ],
            "type": "object"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "type": "string"
          },
          "status": {
            "enum": [
              "legacy_unverified",
              "unavailable",
              "observed"
            ],
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "type": "string"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "data": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "venue": {
                      "enum": [
                        "kalshi",
                        "polymarket"
                      ],
                      "type": "string"
                    },
                    "market_id": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_.:-]+$",
                      "type": "string"
                    },
                    "outcome_id": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_.:-]+$",
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "bid": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "ask": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "observed_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "received_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "closes_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "rules_hash": {
                      "type": "string"
                    },
                    "settlement_source": {
                      "type": "string"
                    },
